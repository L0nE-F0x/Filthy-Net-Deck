node_modules
dist
src-tauri/target
.DS_Store
*.log
!src-tauri/tests/fixtures/logs/*.log
.env
.env.*
.vscode
.idea
*.local

# Installers must never live in the app's public dir — Vite copies public/ into
# the bundle, which recursively inflates every installer. Site downloads live in
# website/downloads/ instead.
public/downloads/

# NOTE: public/aetherfield/ is deliberately NOT ignored. It is Aetherfield's
# built site (~7 MB, mostly the generated star catalogue), vendored by
# `npm run aetherfield`. CI builds this app from a plain checkout and never
# regenerates it, so an ignored folder would ship a galaxy page that boots
# straight to "could not start". Refresh it when Aetherfield changes and
# commit the result. See scripts/sync-aetherfield.mjs.

# Tauri updater signing keys — never commit these
*.key
*.key.pub

# Remotion marketing video — source is committed, renders / audio artifacts are not
marketing-video/out/
marketing-video/.remotion/
marketing-video/public/*.wav


# Linux release tarball staging (npm run linux:tarball) — the artifact is
# attached to the GitHub release, never committed.
dist-linux/
